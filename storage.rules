rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions & RBAC
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'counselor' ||
        request.auth.token.role == 'document_verifier' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'chimadayo43@gmail.com' ||
        request.auth.token.email == 'admin@move2deutschland.com'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId}/documents/{fileName} {
      // Allow read if the user is the owner or staff (super_admin, counselor, verifier).
      allow read: if isOwner(userId) || isStaff();
      
      // Allow write if the user is the owner (with valid size/type) or staff.
      allow write: if (isOwner(userId) 
                       && request.resource.size < 10 * 1024 * 1024
                       && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/.*')))
                   || isStaff();
    }
  }
}
