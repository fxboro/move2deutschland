rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email == 'chimadayo43@gmail.com');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId}/documents/{fileName} {
      // Allow read if the user is the owner or admin.
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow write if the user is the owner (with valid size/type) or admin.
      allow write: if (isOwner(userId) 
                       && request.resource.size < 10 * 1024 * 1024
                       && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/.*')))
                   || isAdmin();
    }
  }
}

