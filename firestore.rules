rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email == 'chimadayo43@gmail.com');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Students can read their own profile. Admins can read all.
      allow read: if isOwner(userId) || isAdmin();
      
      // Students can create their own profile.
      allow create: if isOwner(userId);
      
      // Students can update their own profile. 
      // Admins can update any profile.
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete user data.
      allow delete: if isAdmin();
    }

    match /applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /contactSubmissions/{submissionId} {
      // Anyone can submit a contact inquiry.
      allow create: if true;
      
      // Only admins can read, update, or delete contact inquiries.
      allow read, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      // Public can read approved testimonials.
      allow read: if resource.data.approved == true || isAdmin();
      
      // Only admins can write testimonials.
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      // Students can trigger emails (e.g. submission notifications).
      allow create: if isAuthenticated();
      
      // Only admins can manage the mail queue.
      allow read, update, delete: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
