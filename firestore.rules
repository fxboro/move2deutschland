rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions & RBAC
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' || 
        request.auth.token.admin == true || 
        request.auth.token.email == 'chimadayo43@gmail.com' ||
        request.auth.token.email == 'admin@move2deutschland.com'
      );
    }

    function isCounselor() {
      return isSuperAdmin() || hasRole('counselor');
    }

    function isVerifier() {
      return isSuperAdmin() || hasRole('document_verifier');
    }

    function isStaff() {
      return isSuperAdmin() || isCounselor() || isVerifier();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Students can read their own profile. Staff can read all.
      allow read: if isOwner(userId) || isStaff();
      
      // Students can create their own profile.
      allow create: if isOwner(userId);
      
      // Students can update their own profile. 
      // Staff can update profiles (notes, status, documents).
      allow update: if isOwner(userId) || isStaff();
      
      // Only Super Admins can delete user data.
      allow delete: if isSuperAdmin();
    }

    match /applications/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isSuperAdmin();
    }

    match /contactSubmissions/{submissionId} {
      // Anyone can submit a contact inquiry.
      allow create: if true;
      
      // Counselors and Super Admins can read and update (triage) contact inquiries.
      allow read, update: if isCounselor();

      // Only Super Admins can delete contact inquiries.
      allow delete: if isSuperAdmin();
    }

    match /testimonials/{testimonialId} {
      // Public can read approved testimonials. Staff can read all.
      allow read: if resource.data.approved == true || isStaff();
      
      // Counselors and Super Admins can create and update testimonials.
      allow create, update: if isCounselor();

      // Only Super Admins can delete testimonials.
      allow delete: if isSuperAdmin();
    }

    match /mail/{mailId} {
      // Authenticated users can trigger mail notifications.
      allow create: if isAuthenticated();
      
      // Super Admins can manage the mail queue.
      allow read, update, delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      // Staff can write audit logs; Super Admins can read all.
      allow read: if isSuperAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
