{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "A candidate's detailed application form.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's ID."
        },
        "fullName": {
          "type": "string",
          "description": "The candidate's full name."
        },
        "nigerianCgpa": {
          "type": "number",
          "description": "The candidate's CGPA on a 5.0 scale."
        },
        "germanGrade": {
          "type": "number",
          "description": "The calculated German grade (1.0 - 4.0)."
        },
        "transcriptUrl": {
          "type": "string",
          "description": "URL to the uploaded transcript in Firebase Storage."
        },
        "passportUrl": {
          "type": "string",
          "description": "URL to the uploaded passport in Firebase Storage."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "under_review", "approved", "rejected"],
          "description": "The status of the application."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the application was submitted."
        }
      },
      "required": ["uid", "fullName", "nigerianCgpa", "germanGrade", "transcriptUrl", "passportUrl", "status", "createdAt"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Emails to be sent by the Trigger Email extension.",
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "Recipient email address."
        },
        "message": {
          "type": "object",
          "description": "The email message content.",
          "properties": {
            "subject": { "type": "string" },
            "html": { "type": "string" }
          }
        }
      },
      "required": ["to", "message"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "A submission from the contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The sender's name."
        },
        "email": {
          "type": "string",
          "description": "The sender's email."
        },
        "phone": {
          "type": "string",
          "description": "The sender's phone number."
        },
        "message": {
          "type": "string",
          "description": "The message text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the submission was created."
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "resolved"],
          "description": "Current resolution status of the ticket."
        }
      },
      "required": ["name", "email", "phone", "message", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "A student success story.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The student's name."
        },
        "fromLocation": {
          "type": "string",
          "description": "Original location (e.g. Lagos, Nigeria)."
        },
        "toLocation": {
          "type": "string",
          "description": "Relocation destination (e.g. Munich, Germany)."
        },
        "university": {
          "type": "string",
          "description": "The German university placed in."
        },
        "programme": {
          "type": "string",
          "description": "The academic program studied."
        },
        "quote": {
          "type": "string",
          "description": "The student's testimonial quote."
        },
        "photoUrl": {
          "type": "string",
          "description": "URL to the student's photo."
        },
        "approved": {
          "type": "boolean",
          "description": "Whether the testimonial is approved for public display."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the testimonial was added."
        }
      },
      "required": ["name", "fromLocation", "toLocation", "university", "programme", "quote", "photoUrl", "approved", "createdAt"]
    }
  },
  "firestore": {
    "/applications/{userId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Stores candidate applications, keyed by the user's UID."
    },
    "/mail/{messageId}": {
      "schema": { "$ref": "#/entities/Mail" },
      "description": "Queue for the Trigger Email extension."
    },
    "/contactSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ContactSubmission" },
      "description": "Stores inquiries submitted through the contact page form."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Stores approved student success stories and testimonials."
    }
  }
}
